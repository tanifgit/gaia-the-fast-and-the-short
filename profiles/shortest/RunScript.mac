ROUTINE RunScript
 d $SYSTEM.Python.Run("import os,csv;csv.writer(open('/o/r.csv','w')).writerows([[s[1],*sum(b,()),r*100]for s in csv.reader(os.popen('zcat /i/*|grep ^[0-9]'))if(b:=[(min(v),max(v))for a in s[11:17:5]for v in[[*filter(None,eval(a,{'NaN':0}))]or[0]]])and(r:=max([0]+[(h-l)/l for l,h in b if l]))>1])")
